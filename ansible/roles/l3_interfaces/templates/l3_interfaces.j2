{% for l3_interface in l3_interfaces %}

interface {{l3_interface.name}}

 {% if 'Ethernet' in l3_interface.name and l3_interface.no_switchport is defined %}
 no switchport
 {% endif %}

 {% if l3_interface.vrf is defined %}
 ip vrf forwarding {{l3_interface.vrf}}
 {% endif %}


 {% if l3_interface.ipv4 is defined %}
 ip address {{ l3_interface.ipv4 | ipaddr('address') }} {{ l3_interface.ipv4 | ipaddr('netmask') }}
 {% endif %}

 {% if l3_interface.description is defined %}
 description {{l3_interface.description}}
 {% endif %}
 
 no shutdown
{%endfor%}